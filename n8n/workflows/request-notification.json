      "parameters": {
        "jsCode": "const { createHmac } = require('crypto');\nconst secret = $env.N8N_TO_CONVEX_SECRET;\nif (!secret) throw new Error('Convex signing key unavailable.');\nconst { eventId } = $input.first().json;\nconst timestamp = String(Date.now());\nconst body = JSON.stringify({ eventId });\nconst signature = createHmac('sha256', secret)\n  .update('event-delivered\\n' + timestamp + '\\n' + body).digest('hex');\nreturn [{ json: { timestamp, body, signature } }];"
      },

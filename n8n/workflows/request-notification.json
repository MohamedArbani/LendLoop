      "parameters": {
        "jsCode": "const { createHmac, timingSafeEqual } = require('crypto');\nconst { headers, body } = $input.first().json;\nconst secret = $env.CONVEX_TO_N8N_SECRET;\nif (!secret) throw new Error('Request signing key unavailable.');\nconst timestamp = headers['x-lendloop-timestamp'];\nconst supplied = headers['x-lendloop-signature'];\nconst payload = body?.payload;\nif (!/^\\d{13}$/.test(timestamp ?? '') || Math.abs(Date.now() - Number(timestamp)) > 300_000 ||\n    !/^[a-f0-9]{64}$/.test(supplied ?? '') || typeof payload !== 'string' || payload.length > 256) {\n  return [{ json: { authorized: false } }];\n}\nconst expected = createHmac('sha256', secret).update('request-event\\n' + timestamp + '\\n' + payload).digest();\nif (!timingSafeEqual(expected, Buffer.from(supplied, 'hex'))) return [{ json: { authorized: false } }];\nconst { eventId } = JSON.parse(payload);\nif (typeof eventId !== 'string' || !eventId) throw new Error('Missing event reference.');\nreturn [{ json: { authorized: true, eventId } }];"
      },
